    "apps/squares/games": {
      "release-type": "go",
      "component": "squares-games",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "1.0.0"
    },
    "apps/squares/accounts": {
      "release-type": "go",
      "component": "squares-accounts",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "1.0.0"
    },
    "apps/squares/realtime": {
      "release-type": "go",
      "component": "squares-realtime",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "1.0.0"
    }
  }
}

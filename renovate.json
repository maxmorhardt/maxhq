{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>maxmorhardt/workflows//renovate/default.json"],
  "gitIgnoredAuthors": ["41898283+github-actions[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "go module updates restamp the squares services, so release-please ships them to prod",
      "matchManagers": ["gomod"],
      "semanticCommitType": "fix"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "track each chart's appVersion against its app image",
      "managerFilePatterns": ["/^charts/.+/Chart\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: image=(?<depName>\\S+)\\s+appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}

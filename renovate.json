{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>maxmorhardt/workflows//renovate/default.json"],
  "packageRules": [
    {
      "description": "ship each libs/go release to every squares service right away, as a fix so release-please releases them",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/maxmorhardt/maxhq/libs/go"],
      "groupName": "libs/go",
      "minimumReleaseAge": "0 days",
      "semanticCommitType": "fix"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "track each chart's appVersion against its app image",
      "managerFilePatterns": ["/^charts/.+/Chart\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: image=(?<depName>\\S+)\\s+appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "track image tags that charts pin in values.yaml",
      "managerFilePatterns": ["/^charts/.+/values\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: image=(?<depName>\\S+)\\s+tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}

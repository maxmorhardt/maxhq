{
  "name": "squares",
  "private": true,
  "version": "2.3.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.8.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "dev": "react-router dev",
    "build": "react-router typegen && tsc -b && react-router build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "type-check": "react-router typegen && tsc -b",
    "preview": "vite preview --outDir dist/client",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@react-router/node": "8.5.0",
    "@reduxjs/toolkit": "^2.12.0",
    "eventsource-parser": "^4.1.2",
    "isbot": "^5",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-oidc-context": "^3.3.1",
    "react-redux": "^9.3.0",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "8.5.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write --ignore-unknown"
  }
}

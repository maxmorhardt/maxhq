# shared by every service (realtime ignores the DB_* keys)
DB_HOST=""
DB_PORT=""
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
DB_SSL_MODE=""

# Optional read-replica (omit to use primary for reads)
# DB_READ_HOST=""
# DB_READ_PORT=""
# DB_READ_USER=""
# DB_READ_PASSWORD=""
# DB_READ_NAME=""
# DB_READ_SSL_MODE=""

# JetStream must be enabled on the server; the SQUARES stream is created on startup
NATS_URL=""
# NATS_STREAM_REPLICAS="1"
# NATS_STREAM_MAX_AGE="168h"

# redis://[:password@]host:6379/0
REDIS_URL=""

# shared secret on /internal routes between services
INTERNAL_API_TOKEN=""
# CONTESTS_INTERNAL_URL="http://squares-contests:8080"

# accounts only
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SUPPORT_EMAIL=""
TURNSTILE_SECRET_KEY=""
# CONTACT_RATE_LIMIT="10"
# TURNSTILE_BASE_URL="https://challenges.cloudflare.com"

# Optional (defaults shown)
# SERVER_PORT="8080"
# METRICS_ENABLED="false"
# METRICS_PORT="9090"
# ALLOWED_ORIGINS="http://localhost:3000"

# games only: scores worker (defaults shown)
# SCORES_ENABLED="true"
# SCORES_ACTIVE_INTERVAL="60s"
# SCORES_IDLE_INTERVAL="6h"
# SCORES_LOCK_KEY="910011"
# ESPN_BASE_URL="https://site.api.espn.com"

# realtime only (defaults shown)
# SSE_HEARTBEAT_INTERVAL="25s"
# SSE_REVOCATION_INTERVAL="5m"

# Behind the gateway every request carries X-Auth-Email/Name/Email-Verified/Iat/Exp.
# Locally, send those headers yourself, e.g. with curl -H "X-Auth-Email: you@example.com" ...

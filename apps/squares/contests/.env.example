# postgres; the service migrates its own schema on startup
DB_HOST=""
DB_PORT=""
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
DB_SSL_MODE=""

# optional read replica (omit to read from the primary)
# DB_READ_HOST=""
# DB_READ_PORT=""
# DB_READ_USER=""
# DB_READ_PASSWORD=""
# DB_READ_NAME=""
# DB_READ_SSL_MODE=""

# redis://[user:password@]host:6379/0
REDIS_URL=""

# how long events stay in a stream before they are trimmed (default shown)
# STREAM_RETENTION="168h"

# shared secret on /internal routes between services
INTERNAL_API_TOKEN=""

# server (defaults shown)
# SERVER_PORT="8080"
# METRICS_ENABLED="false"
# METRICS_PORT="9090"
# ALLOWED_ORIGINS="http://localhost:3000"

# Behind the gateway every request carries X-Auth-Email/Name/Email-Verified/Iat/Exp.
# Locally, send those headers yourself; see README.md.
